NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://qc_user:change_me_strong_password@localhost:5432/qc_reports?schema=public
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL of this service, e.g. https://qc-reports.example.com
PUBLIC_BASE_URL=
GOOGLE_SHEET_ID=
# Either a JSON string of the service-account key OR a path to the JSON file.
# Prefer GOOGLE_SERVICE_ACCOUNT_JSON (raw JSON). GOOGLE_SERVICE_ACCOUNT_KEY_FILE is also supported.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SHEET_TAB=QC Reports
ALLOWED_TELEGRAM_CHAT_IDS=
# Optional: comma-separated Telegram user IDs allowed to use admin commands. Defaults to chat allowlist.
ALLOWED_TELEGRAM_USER_IDS=
LOG_LEVEL=info
# Sheets retry knobs
SHEETS_MAX_RETRIES=8
SHEETS_BASE_DELAY_MS=1000
PORT_HEALTH=3000
# WeCom (Enterprise WeChat) receiver — leave empty to disable
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_AES_KEY=
# Group robot key for pushing saved reports into a WeCom group (outbound only)
WECOM_ROBOT_KEY=
